# 兼容 OpenAI 协议的服务地址（通义 / 文心 / 本地 Ollama 均可）
# 通义示例: https://dashscope.aliyuncs.com/compatible-mode/v1
# Ollama 示例: http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini

# 向量化模型与模式
# api   = 调用嵌入接口（需要 embedding 能力）
# hash  = 离线字符 n-gram 哈希向量（无需 API，仅作演示）
# auto  = 优先 api，失败自动回退 hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MODE=auto
